generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  baseImagePath    String
  overlayImagePath String?
  /// Garment silhouette mask for photo templates; design ink is clipped to its alpha.
  maskImagePath    String?
  /// Overlay blend mode: 'over' (legacy alpha), 'multiply' (shadows), 'soft-light' (sheen).
  overlayBlend     String   @default("over")
  /// Small preview of the base image for cards and tabs; null = clients use the full image.
  thumbImagePath   String?
  canvasWidth      Int
  canvasHeight     Int
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  printAreas     PrintArea[]
  designProjects DesignProject[]
  colors         TemplateColor[]

  @@map("product_templates")
}

model TemplateColor {
  id                String  @id @default(uuid()) @db.Uuid
  productTemplateId String  @db.Uuid
  /// Stable key used in URLs and design documents ('white', 'black', ...).
  key               String
  name              String
  /// Swatch color for the picker UI (strict #RRGGBB).
  hex               String
  /// Exactly one default per template (seed-enforced); designs without a colorKey use it.
  isDefault         Boolean @default(false)
  sortOrder         Int     @default(0)
  active            Boolean @default(true)
  /// Template-level (front view) blank in this color; the default color points at the
  /// same files as ProductTemplate.baseImagePath/thumbImagePath.
  baseImagePath     String
  thumbImagePath    String

  productTemplate ProductTemplate          @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  areaImages      TemplateColorAreaImage[]

  @@unique([productTemplateId, key])
  @@map("template_colors")
}

/// Color-specific view images for a print area that carries its own view (e.g. back);
/// mirrors the PrintArea -> ProductTemplate image fallback, one level deeper.
model TemplateColorAreaImage {
  id              String @id @default(uuid()) @db.Uuid
  templateColorId String @db.Uuid
  printAreaId     String @db.Uuid
  baseImagePath   String
  thumbImagePath  String

  templateColor TemplateColor @relation(fields: [templateColorId], references: [id], onDelete: Cascade)
  printArea     PrintArea     @relation(fields: [printAreaId], references: [id], onDelete: Cascade)

  @@unique([templateColorId, printAreaId])
  @@map("template_color_area_images")
}

model PrintArea {
  id                String  @id @default(uuid()) @db.Uuid
  productTemplateId String  @db.Uuid
  key               String
  name              String
  x                 Int
  y                 Int
  width             Int
  height            Int
  active            Boolean @default(true)
  /// Tab/display order in the editor (front = 0, back = 1, ...).
  sortOrder         Int     @default(0)
  /// Area-specific view image; null falls back to ProductTemplate.baseImagePath.
  baseImagePath     String?
  /// Area-specific overlay; null falls back to ProductTemplate.overlayImagePath.
  overlayImagePath  String?
  /// Area-specific garment mask; null falls back to ProductTemplate.maskImagePath.
  maskImagePath     String?
  /// Area-specific overlay blend; null falls back to ProductTemplate.overlayBlend.
  overlayBlend      String?
  /// Area-specific thumb; null falls back to ProductTemplate.thumbImagePath.
  thumbImagePath    String?
  /// Physical printable width in inches; null = clients assume a 12in DTG platen.
  widthInches       Float?
  /// Physical height in inches; null = derived from widthInches keeping canvas aspect.
  heightInches      Float?

  productTemplate ProductTemplate          @relation(fields: [productTemplateId], references: [id], onDelete: Cascade)
  colorAreaImages TemplateColorAreaImage[]

  @@unique([productTemplateId, key])
  @@map("print_areas")
}

model UploadedAsset {
  id               String   @id @default(uuid()) @db.Uuid
  originalFilename String
  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?
  storagePath      String
  createdAt        DateTime @default(now())

  @@map("uploaded_assets")
}

model DesignProject {
  id                String   @id @default(uuid()) @db.Uuid
  productTemplateId String   @db.Uuid
  designJson        Json
  /// Map of printAreaKey -> { path, renderedAt }; null/empty until rendered.
  previewPaths      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productTemplate ProductTemplate @relation(fields: [productTemplateId], references: [id], onDelete: Restrict)

  @@map("design_projects")
}
